# ============================================
# 차놀자 홈페이지 환경 변수 설정
# ============================================
# 이 파일을 .env.local로 복사하여 실제 값을 입력하세요.
# cp .env.example .env.local

# --------------------------------------------
# Supabase (필수)
# https://supabase.com/dashboard 에서 확인
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --------------------------------------------
# 네이버 지도 API (필수)
# https://console.ncloud.com/naver-service/application
# --------------------------------------------
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_map_client_id
NAVER_MAP_CLIENT_SECRET=your_naver_map_client_secret

# --------------------------------------------
# 카카오 API (필수 - 주소 좌표 변환용)
# https://developers.kakao.com/console/app
# --------------------------------------------
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# --------------------------------------------
# 토스페이먼츠 (필수)
# https://developers.tosspayments.com/
# 테스트 키: test_ck_xxx / test_sk_xxx
# 라이브 키: live_ck_xxx / live_sk_xxx
# --------------------------------------------
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxx
TOSS_PAYMENTS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxx
TOSS_PAYMENTS_WEBHOOK_SECRET=your_webhook_secret

# --------------------------------------------
# 스플릿 결제 (선택 - 분배 결제 사용 시)
# 토스페이먼츠 서브몰 ID
# --------------------------------------------
HQ_SUBMALL_ID=your_hq_submall_id
DEFAULT_BRANCH_SUBMALL_ID=your_default_branch_submall_id

# --------------------------------------------
# 사이트 설정
# --------------------------------------------
NEXT_PUBLIC_URL=http://localhost:3000

# --------------------------------------------
# CI/CD용 (GitHub Actions에서 자동 설정됨)
# --------------------------------------------
# CI=true
